@@ -83,0 +93,15 @@ def _place_refs(ref_ids, modes, h_, w_):
+def _placement_mix(mode):
+    """Turn a user-facing balanced mode into a seamless positional mixture.
+
+    A literal 75% spatial overlap creates a discontinuity at x=25% of the
+    target.  Duplicating the clean reference tokens and weighting their
+    aligned/beside attention keeps the mixture spatially uniform instead.
+    Legacy mode strings are retained so saved workflows continue to load.
+    """
+    if mode.startswith("balanced (75%"):
+        return [("aligned (trained)", 0.75), ("beside (right of target)", 0.25)]
+    if mode.startswith("balanced"):
+        return [("aligned (trained)", 0.50), ("beside (right of target)", 0.50)]
+    return [(mode, 1.0)]
+
