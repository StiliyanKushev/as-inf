# Never commit credentials or machine-specific secrets.
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
credentials*
secrets*

# Large base-model weights belong on RunPod network storage.
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf

# The four workflow LoRAs are versioned with Git LFS.
!models/
!models/loras/
!models/loras/FLUX2_KLEIN_UNLOCKED_V2.safetensors
!models/loras/klein_instagramreality_v2.safetensors
!models/loras/HighDetail.safetensors
!models/loras/alexsparks.safetensors

# Generated and source media stay outside Git.
input/
output/
images/
*.png
*.jpg
*.jpeg
*.webp
*.mp4

# Canonical synthetic persona references are portable workflow inputs.
!assets/
!assets/persona_refs/
!assets/persona_refs/*.png

# The curated LoRA training dataset is versioned with Git LFS.
!training/
!training/datasets/
!training/datasets/vexa_person/
!training/datasets/vexa_person/*.png
!research-results/three-way-2026-10-28/**/*.png
!research-results/three-way-2026-10-28/**/*.jpg

# Local/runtime files.
.venv/
__pycache__/
*.pyc
*.log
*.pid
.DS_Store
# Public upstream repositories cloned only for workflow inspection.
vendor/
